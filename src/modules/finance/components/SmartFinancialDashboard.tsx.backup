import React, { useState, useEffect } from 'react';
import { DollarSign, TrendingUp, Building2, RefreshCw, Users, TreeDeciduous, Sparkles, Heart, BarChart3, Zap } from 'lucide-react';
import { BackButton } from '../../../components/common/BackButton';
import { AnimatedCounter } from '../../../components/ui/AnimatedCounter';
import { Phase1FinanceService, FarmFinancePhase1 } from '../services/phase1FinanceService';
import { SimpleLoader } from '../../../components/common/SimpleLoader';
import { ExpandableFinancialCard } from './ExpandableFinancialCard';
import { SettlementService } from '../services/settlementService';
import { SmartFinancialAnalyticsDashboard } from './SmartFinancialAnalyticsDashboard';
import { ModernFinancialInterface } from './ModernFinancialInterface';

interface SmartFinancialDashboardProps {
  onBack?: () => void;
}

export function SmartFinancialDashboard({ onBack }: SmartFinancialDashboardProps) {
  const [finances, setFinances] = useState<FarmFinancePhase1[]>([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [expandedCardIndex, setExpandedCardIndex] = useState<number | null>(null);
  const [showAnalyticsDashboard, setShowAnalyticsDashboard] = useState(false);
  const [showModernInterface, setShowModernInterface] = useState(false);
  const [stats, setStats] = useState({
    totalFarms: 0,
    totalMarketingAmount: 0,
    totalActualAmount: 0,
    totalInvested: 0,
    totalRevenueCollected: 0,
    averageCoverage: 0,
    averageCompletion: 0,
    syncedFarms: 0,
    readyForSettlement: 0
  });
  const [settlementStats, setSettlementStats] = useState({
    farms_ready_for_settlement: 0,
    farms_settled: 0,
    farms_owned_by_platform: 0,
    platform_wallet_balance: 0,
    charity_wallet_balance: 0,
    charity_percentage: 25
  });

  useEffect(() => {
    loadData();
  }, []);

  const loadData = async () => {
    try {
      setLoading(true);
      const [financesData, statsData, settlementStatsData] = await Promise.all([
        Phase1FinanceService.getAllFarmFinances(),
        Phase1FinanceService.getStats(),
        SettlementService.getSettlementStatistics()
      ]);

      setFinances(financesData);
      setStats(statsData);
      setSettlementStats(settlementStatsData);
    } catch (error) {
      console.error('Error loading financial data:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleRefresh = async () => {
    setRefreshing(true);
    await loadData();
    setRefreshing(false);
  };

  if (loading) {
    return <SimpleLoader message="جاري تحميل النظام المالي الذكي..." />;
  }

  if (showModernInterface) {
    return <ModernFinancialInterface onBack={() => setShowModernInterface(false)} />;
  }

  if (showAnalyticsDashboard) {
    return <SmartFinancialAnalyticsDashboard onBack={() => setShowAnalyticsDashboard(false)} />;
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-green-50 p-8">
      {onBack && <BackButton onClick={onBack} />}

      <div className="mx-auto max-w-7xl">
        {/* Header */}
        <div className="mb-8 text-center">
          <div className="mb-4 flex justify-center gap-4">
            <div
              className="flex h-20 w-20 items-center justify-center rounded-2xl shadow-2xl"
              style={{
                background: 'linear-gradient(135deg, #D4AF37 0%, #FFD700 100%)',
              }}
            >
              <DollarSign className="h-10 w-10 text-white" />
            </div>

            <button
              onClick={() => {
                console.log('✅ Opening Modern Financial Interface');
                setShowModernInterface(true);
              }}
              className="px-6 py-3 bg-gradient-to-r from-green-600 via-emerald-500 to-teal-600 text-white rounded-xl font-bold shadow-xl hover:scale-105 transition-all flex items-center gap-2 animate-pulse"
              style={{ fontFamily: 'Tajawal' }}
              title="الواجهة المالية المتطورة الجديدة"
            >
              <Zap className="w-6 h-6" />
              الواجهة المتطورة الجديدة
              <Sparkles className="w-5 h-5" />
            </button>

            <button
              onClick={() => setShowAnalyticsDashboard(true)}
              className="px-6 py-3 bg-gradient-to-r from-purple-500 to-violet-600 text-white rounded-xl font-bold shadow-xl hover:scale-105 transition-all flex items-center gap-2"
              style={{ fontFamily: 'Tajawal' }}
            >
              <BarChart3 className="w-6 h-6" />
              لوحة التحليل الذكي
            </button>
          </div>

          <h1 className="mb-3 text-5xl font-black text-slate-800">
            النظام المالي الذكي
          </h1>
          <p className="text-xl text-slate-600">
            المرحلة الأولى - ربط الإدارات وبناء الكيانات المالية
          </p>

          <button
            onClick={handleRefresh}
            disabled={refreshing}
            className="mt-4 flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-slate-700 shadow-lg transition-all hover:scale-105 hover:shadow-xl disabled:opacity-50 mx-auto"
          >
            <RefreshCw className={`h-5 w-5 ${refreshing ? 'animate-spin' : ''}`} />
            <span>تحديث البيانات</span>
          </button>
        </div>

        {/* Settlement Stats Bar */}
        <div className="mb-8 grid gap-6 md:grid-cols-4">
          <div className="rounded-2xl border-2 border-yellow-200 bg-gradient-to-br from-yellow-50 to-amber-50 p-6 shadow-lg">
            <div className="mb-4 flex items-center justify-between">
              <Sparkles className="h-10 w-10 text-yellow-600" />
              <span className="text-3xl font-black text-yellow-800">
                <AnimatedCounter end={settlementStats.farms_ready_for_settlement} />
              </span>
            </div>
            <h3 className="text-lg font-bold text-yellow-800">المزارع الجاهزة للتسوية</h3>
            <p className="mt-2 text-sm text-yellow-600">
              جاهزة للتحويل اليدوي
            </p>
          </div>

          <div className="rounded-2xl border-2 border-green-200 bg-gradient-to-br from-green-50 to-emerald-50 p-6 shadow-lg">
            <div className="mb-4 flex items-center justify-between">
              <Building2 className="h-10 w-10 text-green-600" />
              <span className="text-3xl font-black text-green-800">
                <AnimatedCounter end={settlementStats.farms_settled} />
              </span>
            </div>
            <h3 className="text-lg font-bold text-green-800">المزارع المسددة</h3>
            <p className="mt-2 text-sm text-green-600">
              تمت التسوية المالية
            </p>
          </div>

          <div className="rounded-2xl border-2 border-purple-200 bg-gradient-to-br from-purple-50 to-violet-50 p-6 shadow-lg">
            <div className="mb-4 flex items-center justify-between">
              <Building2 className="h-10 w-10 text-purple-600" />
              <span className="text-3xl font-black text-purple-800">
                <AnimatedCounter end={settlementStats.farms_owned_by_platform} />
              </span>
            </div>
            <h3 className="text-lg font-bold text-purple-800">المزارع المملوكة للمنصة</h3>
            <p className="mt-2 text-sm text-purple-600">
              {((settlementStats.platform_wallet_balance / 1000000).toFixed(1))}م ريال
            </p>
          </div>

          <div className="rounded-2xl border-2 border-pink-200 bg-gradient-to-br from-pink-50 to-rose-50 p-6 shadow-lg">
            <div className="mb-4 flex items-center justify-between">
              <Heart className="h-10 w-10 text-pink-600" />
              <span className="text-2xl font-black text-pink-800">
                {settlementStats.charity_percentage}%
              </span>
            </div>
            <h3 className="text-lg font-bold text-pink-800">نسبة الخير</h3>
            <p className="mt-2 text-sm text-pink-600">
              {((settlementStats.charity_wallet_balance / 1000000).toFixed(1))}م ريال
            </p>
          </div>
        </div>

        {/* Stats Cards */}
        <div className="mb-8 grid gap-6 md:grid-cols-4">
          <div className="rounded-2xl border-2 border-slate-200 bg-white p-6 shadow-lg">
            <div className="mb-4 flex items-center justify-between">
              <Building2 className="h-10 w-10 text-blue-600" />
              <span className="text-3xl font-black text-slate-800">
                <AnimatedCounter end={stats.totalFarms} />
              </span>
            </div>
            <h3 className="text-lg font-bold text-slate-700">إجمالي المزارع</h3>
            <p className="mt-2 text-sm text-slate-500">
              مزامن: {stats.syncedFarms} / {stats.totalFarms}
            </p>
          </div>

          <div className="rounded-2xl border-2 border-slate-200 bg-white p-6 shadow-lg">
            <div className="mb-4 flex items-center justify-between">
              <DollarSign className="h-10 w-10 text-green-600" />
              <span className="text-3xl font-black text-slate-800">
                {(stats.totalRevenueCollected / 1000000).toFixed(1)}م
              </span>
            </div>
            <h3 className="text-lg font-bold text-slate-700">الإيرادات المجمعة</h3>
            <p className="mt-2 text-sm text-slate-500">
              {stats.totalRevenueCollected.toLocaleString()} ريال
            </p>
          </div>

          <div className="rounded-2xl border-2 border-slate-200 bg-white p-6 shadow-lg">
            <div className="mb-4 flex items-center justify-between">
              <TrendingUp className="h-10 w-10 text-amber-600" />
              <span className="text-3xl font-black text-slate-800">
                {stats.averageCompletion.toFixed(1)}%
              </span>
            </div>
            <h3 className="text-lg font-bold text-slate-700">متوسط الاكتمال</h3>
            <p className="mt-2 text-sm text-slate-500">
              جاهز للتسوية: {stats.readyForSettlement}
            </p>
          </div>

          <div className="rounded-2xl border-2 border-green-200 bg-gradient-to-br from-green-50 to-emerald-50 p-6 shadow-lg">
            <div className="mb-4 flex items-center justify-between">
              <DollarSign className="h-10 w-10 text-green-700" />
              <span className="text-3xl font-black text-green-800">
                {(stats.totalActualAmount / 1000000).toFixed(1)}م
              </span>
            </div>
            <h3 className="text-lg font-bold text-green-800">للملاك</h3>
            <p className="mt-2 text-sm text-green-600">
              السعر الفعلي الإجمالي
            </p>
          </div>
        </div>

        {/* Farm Cards Grid */}
        <div className="mb-8">
          <h2 className="mb-6 text-2xl font-black text-slate-800">
            البطاقات المالية للمزارع
          </h2>

          {finances.length === 0 ? (
            <div className="rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50 p-12 text-center">
              <Building2 className="mx-auto mb-4 h-16 w-16 text-slate-400" />
              <h3 className="mb-2 text-xl font-bold text-slate-700">
                لا توجد بطاقات مالية
              </h3>
              <p className="text-slate-500">
                سيتم إنشاء البطاقات تلقائياً عند إضافة مزارع جديدة
              </p>
            </div>
          ) : (
            <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {finances.map((finance, index) => (
                <ExpandableFinancialCard
                  key={finance.id}
                  finance={finance}
                  isExpanded={expandedCardIndex === index}
                  onToggle={() => setExpandedCardIndex(expandedCardIndex === index ? null : index)}
                  onClose={() => setExpandedCardIndex(null)}
                />
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

// ========================================
// Farm Finance Card Component
// ========================================

interface FarmFinanceCardProps {
  finance: FarmFinancePhase1;
}

function FarmFinanceCard({ finance }: FarmFinanceCardProps) {
  const [showSettlementPanel, setShowSettlementPanel] = useState(false);
  const completionPercentage = finance.financial_completion_percentage || 0;
  const revenueCollected = finance.total_revenue_collected || 0;
  const collectedFromInvestors = finance.collected_from_investors || 0;
  const remainingForOwner = finance.remaining_for_owner || 0;
  const visualPercentage = finance.completion_percentage_visual || 0;
  const healthStatus = (finance.financial_health_status || 'low') as 'low' | 'medium' | 'high' | 'complete';
  const flashShown = finance.completion_flash_shown || false;
  const settlementStatus = finance.settlement_status || 'collecting';
  const isReadyForSettlement = settlementStatus === 'ready_for_settlement';

  const completionColor =
    completionPercentage >= 100
      ? 'text-green-600'
      : completionPercentage >= 75
      ? 'text-blue-600'
      : completionPercentage >= 50
      ? 'text-amber-600'
      : 'text-slate-600';

  const settlementStatusBadge = {
    collecting: { bg: 'bg-blue-100', text: 'text-blue-800', label: 'جمع إيرادات' },
    ready_for_settlement: { bg: 'bg-yellow-100', text: 'text-yellow-800', label: '✨ جاهزة للتسوية' },
    settling: { bg: 'bg-orange-100 animate-pulse', text: 'text-orange-800', label: '⏳ قيد التسوية' },
    settled: { bg: 'bg-green-100', text: 'text-green-800', label: '✅ تمت التسوية' },
    owned_by_platform: { bg: 'bg-purple-100', text: 'text-purple-800', label: '🏛️ مملوكة للمنصة' }
  }[settlementStatus];

  const syncStatusColor =
    finance.sync_status === 'synced'
      ? 'bg-green-100 text-green-800'
      : finance.sync_status === 'error'
      ? 'bg-red-100 text-red-800'
      : 'bg-amber-100 text-amber-800';

  return (
    <>
      {showSettlementPanel && (
        <ManualSettlementPanel
          farmCode={finance.farm_code}
          farmName={finance.farm_name}
          ownerName={finance.owner_name || 'غير محدد'}
          actualAmount={finance.actual_amount}
          collectedAmount={collectedFromInvestors}
          settlementStatus={settlementStatus}
          onSettlementComplete={() => {
            setShowSettlementPanel(false);
            window.location.reload();
          }}
          onClose={() => setShowSettlementPanel(false)}
        />
      )}

      <div className="space-y-4">
        {isReadyForSettlement && (
          <div className="rounded-xl bg-gradient-to-r from-yellow-400 via-amber-500 to-yellow-600 p-4 text-white shadow-xl animate-golden-continuous-flash">
            <div className="flex items-center gap-3">
              <Sparkles className="w-8 h-8 animate-spin-slow" />
              <div className="flex-1">
                <h4 className="text-lg font-black mb-1" style={{ fontFamily: 'Tajawal' }}>
                  ✨ جاهزة للتسوية – الرجاء اعتماد التحويل لصاحب المزرعة
                </h4>
                <p className="text-sm opacity-90" style={{ fontFamily: 'Tajawal' }}>
                  المبلغ المجمع: {collectedFromInvestors.toLocaleString()} ريال – جاهز للتحويل
                </p>
              </div>
              <button
                onClick={() => setShowSettlementPanel(true)}
                className="bg-white text-yellow-600 px-6 py-3 rounded-xl font-bold hover:bg-yellow-50 transition-all shadow-lg hover:scale-105"
                style={{ fontFamily: 'Tajawal' }}
              >
                ⚡ بدء التسوية
              </button>
            </div>
          </div>
        )}

        <div
          className={`group relative overflow-hidden rounded-2xl border-2 bg-white p-6 shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl ${
            isReadyForSettlement ? 'ring-4 ring-yellow-400 ring-opacity-50' : ''
          }`}
          style={{
            borderColor: isReadyForSettlement
              ? 'rgba(251, 191, 36, 0.8)'
              : 'rgba(212, 175, 55, 0.3)',
          }}
        >
      {/* Header */}
      <div className="mb-4 flex items-start justify-between">
        <div>
          <h3 className="text-xl font-black text-slate-800">
            {finance.farm_name}
          </h3>
          <p className="mt-1 text-sm font-mono text-slate-500">
            {finance.farm_code}
          </p>
        </div>
        <div
          className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl"
          style={{
            background: 'linear-gradient(135deg, #D4AF37 0%, #FFD700 100%)',
          }}
        >
          <Building2 className="h-6 w-6 text-white" />
        </div>
      </div>

      {/* Status Badges */}
      <div className="mb-4 flex gap-2">
        <span className={`inline-block rounded-full px-3 py-1 text-xs font-bold ${settlementStatusBadge.bg} ${settlementStatusBadge.text}`}>
          {settlementStatusBadge.label}
        </span>
        {finance.investors_locked && (
          <span className="inline-block rounded-full bg-red-100 px-3 py-1 text-xs font-bold text-red-800">
            🔒 مقفل
          </span>
        )}
      </div>

      {/* Financial Completion Progress */}
      <div className="mb-4">
        <div className="mb-2 flex items-center justify-between">
          <span className="text-sm font-medium text-slate-700">نسبة الاكتمال المالي</span>
          <span className={`text-lg font-bold ${completionColor}`}>
            {completionPercentage.toFixed(1)}%
          </span>
        </div>
        <div className="h-3 w-full overflow-hidden rounded-full bg-slate-200">
          <div
            className="h-full rounded-full transition-all duration-500"
            style={{
              width: `${Math.min(completionPercentage, 100)}%`,
              background: completionPercentage >= 100
                ? 'linear-gradient(90deg, #10b981 0%, #059669 100%)'
                : completionPercentage >= 75
                ? 'linear-gradient(90deg, #3b82f6 0%, #2563eb 100%)'
                : 'linear-gradient(90deg, #f59e0b 0%, #d97706 100%)'
            }}
          />
        </div>
        <p className="mt-1 text-xs text-slate-500">
          {revenueCollected.toLocaleString()} / {finance.actual_amount.toLocaleString()} ريال
        </p>
      </div>

      {/* Financial Summary */}
      <div className="space-y-3">
        {/* Revenue Collected */}
        <div className="flex items-center justify-between rounded-lg bg-gradient-to-r from-green-50 to-emerald-50 p-3">
          <span className="text-sm font-medium text-slate-700">الإيرادات المجمعة</span>
          <span className="text-lg font-bold text-green-700">
            {(revenueCollected / 1000000).toFixed(2)}م
          </span>
        </div>

        {/* Actual Amount */}
        {finance.actual_amount > 0 && (
          <div className="flex items-center justify-between rounded-lg bg-blue-50 p-3">
            <span className="text-sm font-medium text-slate-700">السعر الفعلي</span>
            <span className="text-lg font-bold text-blue-700">
              {(finance.actual_amount / 1000000).toFixed(2)}م
            </span>
          </div>
        )}

        {/* Investors Count */}
        <div className="flex items-center gap-4 pt-2">
          <div className="flex items-center gap-2">
            <Users className="h-4 w-4 text-slate-500" />
            <span className="text-sm text-slate-600">
              {finance.total_investors} مستثمر
            </span>
          </div>
          <div className="flex items-center gap-2">
            <TreeDeciduous className="h-4 w-4 text-slate-500" />
            <span className="text-sm text-slate-600">
              {finance.total_trees_sold} شجرة
            </span>
          </div>
        </div>
      </div>

      {/* Owner Info */}
      {finance.owner_name && (
        <div className="mt-4 border-t border-slate-200 pt-4">
          <p className="text-xs text-slate-500">المالك</p>
          <p className="mt-1 font-bold text-slate-700">{finance.owner_name}</p>
        </div>
      )}

      {/* Financial Barcode */}
      <div className="mt-4 border-t border-slate-200 pt-4">
        <p className="text-xs font-mono text-slate-400">{finance.financial_barcode}</p>
      </div>
    </div>

    {/* Live Financial Stats Card */}
    <LiveFinancialStatsCard
      farmCode={finance.farm_code}
      collectedFromInvestors={collectedFromInvestors}
      remainingForOwner={remainingForOwner}
      actualAmount={finance.actual_amount}
      visualPercentage={visualPercentage}
      healthStatus={healthStatus}
      flashShown={flashShown}
    />
      </div>
    </>
  );
}

const settlementStyles = `
@keyframes golden-continuous-flash {
  0%, 100% {
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.6), 0 0 40px rgba(251, 191, 36, 0.4);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 40px rgba(251, 191, 36, 0.8), 0 0 60px rgba(251, 191, 36, 0.6);
    transform: scale(1.01);
  }
}

@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.animate-golden-continuous-flash {
  animation: golden-continuous-flash 2s ease-in-out infinite;
}

.animate-spin-slow {
  animation: spin-slow 3s linear infinite;
}
`;

if (typeof document !== 'undefined' && !document.getElementById('settlement-styles')) {
  const styleSheet = document.createElement('style');
  styleSheet.id = 'settlement-styles';
  styleSheet.textContent = settlementStyles;
  document.head.appendChild(styleSheet);
}
